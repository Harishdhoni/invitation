{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "missing": [
        { "type": "query", "key": "w" },
        { "type": "query", "key": "template" },
        { "type": "query", "key": "template-file" },
        { "type": "query", "key": "editor-preview" }
      ],
      "destination": "/home.html"
    },
    { "source": "/:slug([a-z0-9-]+)", "destination": "/api/invite?slug=:slug" }
  ],
  "functions": {
    "api/invite.js": { "includeFiles": "public/index.html" }
  },
  "headers": [
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(admin|editor)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
