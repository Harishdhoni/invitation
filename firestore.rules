rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Paste the admin user's UID here (Firebase console > Authentication > Users).
    // UID, not email: anyone can self-register an unverified email/password account.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'YH9Rv09hCkcrTBKam3u0jcDwzRy2';
    }

    // Editor access. The admin gives someone a PIN for one event (pins/<PIN> = { slug }); the editor page
    // signs them in anonymously and they save { pin, slug } as editors/<their uid>. From then on they
    // may change that event, and only that event, for as long as the pin document exists —
    // changing or revoking the PIN in the admin deletes it, which ends their access at once.
    function pinPath(pin) {
      return /databases/$(database)/documents/pins/$(pin);
    }
    function editorPath() {
      return /databases/$(database)/documents/editors/$(request.auth.uid);
    }
    function isEditorOf(slug) {
      return request.auth != null
        && exists(editorPath())
        && get(editorPath()).data.slug == slug
        && exists(pinPath(get(editorPath()).data.pin))
        && get(pinPath(get(editorPath()).data.pin)).data.slug == slug;
    }

    // Any editor with a live PIN (for any event); used to let editors list designs.
    function isAnyEditor() {
      return request.auth != null
        && exists(editorPath())
        && exists(pinPath(get(editorPath()).data.pin));
    }

    function weddingPath(slug) {
      return /databases/$(database)/documents/weddings/$(slug);
    }
    // Same pattern as isValidSlug in js/defaults.js (the reserved names are only checked there).
    function isSlug(s) {
      return s is string && s.size() >= 3 && s.size() <= 40 && s.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    // Whether guests may open an event or extra link now: it is paid for (a missing `paid` counts as paid),
    // switched on, and today in India is on or after its start date and on or before its end date. With no
    // end date it stays open until 15 days after the event's main date. Dates are "YYYY-MM-DD" strings, compared as numbers like 20270212 so no date parsing
    // is needed. Same check as linkState() in js/defaults.js. An extra link has no main date; its details
    // come from its event, which guests can read only while that event is open.
    function isDay(s) {
      return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function dayNumber(s) {
      return int(s.replace('-', ''));
    }
    function indiaDayNumber(t) {
      let india = t + duration.value(330, 'm');
      return india.year() * 10000 + india.month() * 100 + india.day();
    }
    function isLive(d) {
      let iso = d.get('weddingDateTimeISO', '');
      let main = (iso is string && iso.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T.*')) ? iso.split('T')[0] : '';
      let start = d.get('startDate', '');
      let end = d.get('endDate', '');
      return d.get('paid', true) != false
        && d.get('active', true) != false
        && (!isDay(start) || indiaDayNumber(request.time) >= dayNumber(start))
        && (isDay(end)
          ? indiaDayNumber(request.time) <= dayNumber(end)
          : (main == '' || indiaDayNumber(request.time - duration.value(15, 'd')) <= dayNumber(main)));
    }

    // A template an event of this category may use ("" is the built-in Classic, for weddings only).
    function templateFits(id, category) {
      return (id == '' && category == 'wedding')
        || (id is string && id != ''
            && get(/databases/$(database)/documents/templates/$(id)).data.categoryId == category);
    }

    // An editor may change their event's list of extra links only by adding one that is created in the
    // same write and points at the event (up to 2, so 3 links in all; MAX_LINKS in js/defaults.js), or by
    // removing one that is deleted in the same write.
    function linksChangeOk(slug, before, after) {
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      return after == before
        || (added.size() == 1 && removed.size() == 0 && after.size() == before.size() + 1 && after.size() <= 2
            && isSlug(added[0]) && existsAfter(weddingPath(added[0]))
            && getAfter(weddingPath(added[0])).data.get('parent', '') == slug)
        || (removed.size() == 1 && added.size() == 0 && after.size() == before.size() - 1
            && !existsAfter(weddingPath(removed[0])));
    }

    // PINs are the document ids: anyone signed in can look one up (that is how a PIN is checked),
    // so they are long and random (8 characters, see js/pin.js). Only the admin can list or change them.
    match /pins/{pin} {
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
    }

    // What an editor has signed in with. A browser can only claim a PIN that exists, for the event it belongs to.
    match /editors/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'slug'])
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[A-Z0-9]{6,32}$')
        && request.resource.data.slug is string
        && exists(pinPath(request.resource.data.pin))
        && get(pinPath(request.resource.data.pin)).data.slug == request.resource.data.slug;
      allow list, write: if isAdmin();
    }

    // Site-wide settings (site/settings: which wedding "/" shows). Public read, admin-only write.
    // site/config is the pre-multi-wedding invitation, kept so the admin can import it.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Who bought each invitation and how they paid ({ customer, phone, amount, method, ref, ... }).
    // Kept apart from weddings/<slug>, which anyone with the link can read. Admin only.
    match /orders/{slug} {
      allow read, write: if isAdmin();
    }

    // Event categories (weddings, housewarmings, birthdays…), managed on the admin page.
    match /categories/{categoryId} {
      allow read, write: if isAdmin();
    }

    // Invitation designs: one HTML page each. Guests' pages load the one their event uses,
    // so anyone can get a template by id. Editors can also list them, to pick a design for their event;
    // only the admin can add, change or delete them.
    match /templates/{templateId} {
      allow get: if true;
      allow list: if isAdmin() || isAnyEditor();
      allow write: if isAdmin();
    }

    // One document per event of any category, keyed by its link name (weddings/arjun-meera).
    // The collection name predates categories and is kept so existing links keep working.
    // An event can also have extra links: small documents { parent, category, templateId, hiddenSections,
    // active, startDate, endDate } that show the parent event's details in another design.
    // Guests can open an event or link they have the link to while it is open (isLive); the admin and the
    // event's editor can open it any time. Only the admin can list them all.
    match /weddings/{weddingId} {
      allow get: if resource == null || isAdmin() || isLive(resource.data)
        || isEditorOf(weddingId) || isEditorOf(resource.data.get('parent', ''));
      allow list, write: if isAdmin();

      // An editor can change the details of their event, which parts it shows, and pick another design
      // from the event's own category. They cannot change its category, mark it paid, switch it on or off,
      // or set its dates.
      allow update: if isEditorOf(weddingId)
        && request.resource.data.get('category', 'wedding') == resource.data.get('category', 'wedding')
        && request.resource.data.get('paid', true) == resource.data.get('paid', true)
        && request.resource.data.get('active', true) == resource.data.get('active', true)
        && request.resource.data.get('startDate', '') == resource.data.get('startDate', '')
        && request.resource.data.get('endDate', '') == resource.data.get('endDate', '')
        && request.resource.data.get('parent', '') == ''
        && request.resource.data.get('hiddenSections', []) is list
        && linksChangeOk(weddingId, resource.data.get('links', []), request.resource.data.get('links', []))
        && (
          request.resource.data.get('templateId', '') == resource.data.get('templateId', '')
          || templateFits(request.resource.data.templateId, resource.data.get('category', 'wedding'))
        );

      // An editor can add extra links to their event (see linksChangeOk for the limit). A new link starts
      // switched on with no dates (the admin sets those), in the event's category, and is added to the
      // event's `links` in the same write.
      allow create: if isSlug(weddingId)
        && request.resource.data.keys().hasOnly(['parent', 'category', 'templateId', 'hiddenSections',
             'active', 'startDate', 'endDate', 'createdAt', 'updatedAt'])
        && isEditorOf(request.resource.data.parent)
        && request.resource.data.active == true
        && request.resource.data.startDate == ''
        && request.resource.data.endDate == ''
        && request.resource.data.hiddenSections is list
        && request.resource.data.category == get(weddingPath(request.resource.data.parent)).data.get('category', 'wedding')
        && templateFits(request.resource.data.templateId, request.resource.data.category)
        && weddingId in getAfter(weddingPath(request.resource.data.parent)).data.get('links', []);

      // ...change an extra link's design and which parts it shows...
      allow update: if resource.data.get('parent', '') != ''
        && isEditorOf(resource.data.parent)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['templateId', 'hiddenSections', 'updatedAt'])
        && request.resource.data.hiddenSections is list
        && (
          request.resource.data.get('templateId', '') == resource.data.get('templateId', '')
          || templateFits(request.resource.data.templateId, resource.data.get('category', 'wedding'))
        );

      // ...and delete one, removing it from the event's `links` in the same write.
      allow delete: if resource.data.get('parent', '') != ''
        && isEditorOf(resource.data.parent)
        && !(weddingId in getAfter(weddingPath(resource.data.parent)).data.get('links', []));

      // Uploaded photos stored as compressed data URLs.
      match /images/{imageId} {
        allow get: if true;
        allow list: if isAdmin();
        allow write: if isAdmin() || isEditorOf(weddingId);
      }

      // Background music, split into ~900 KB chunks (docs "<version>_<index>").
      match /music/{chunkId} {
        allow get: if true;
        allow list: if isAdmin();
        allow write: if isAdmin() || isEditorOf(weddingId);
      }

      // Guest book, shared by the event's extra links. Guests can read visible wishes and add new ones
      // while the event is open; only the admin can see hidden ones, hide/unhide, or delete.
      // The admin can also create wishes as-is (used when importing the old invitation).
      // An editor can see hidden wishes and hide, unhide or delete them, but not rewrite them.
      match /wishes/{wishId} {
        allow read: if (resource.data.hidden == false && isLive(get(weddingPath(weddingId)).data))
          || isAdmin() || isEditorOf(weddingId);

        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'hidden'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500
          && request.resource.data.hidden == false
          && request.resource.data.createdAt == request.time
          && isLive(get(weddingPath(weddingId)).data)
          && get(weddingPath(weddingId)).data.get('parent', '') == ''
        );

        allow update: if isAdmin() || (isEditorOf(weddingId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']));
        allow delete: if isAdmin() || isEditorOf(weddingId);
      }
    }

    // Data of the original single invitation (imported into weddings/ from the admin page).
    // Same access as before, so a site still running the single-invitation code keeps working.
    match /images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /music/{chunkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /wishes/{wishId} {
      allow read: if resource.data.hidden == false || isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'hidden'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }
  }
}
